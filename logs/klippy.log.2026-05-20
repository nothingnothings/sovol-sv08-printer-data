[fan]
pin = multi_pin:print_cooling_fan_pins
max_power = 1.0

[fan_generic exhaust_fan]
pin = PA2
max_power = 1.0

[controller_fan MCU_fan]
pin = PA1
max_power = 1
kick_start_time = 0.5
fan_speed = 1
idle_timeout = 300
