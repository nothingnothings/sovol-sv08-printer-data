[verify_heater extruder]
max_error = 120
check_gain_time = 30
hysteresis = 5
heating_gain = 2

[filament_switch_sensor filament_sensor]
pause_on_runout = True
event_delay = 3.0
pause_delay = 0.5
switch_pin = PE9

