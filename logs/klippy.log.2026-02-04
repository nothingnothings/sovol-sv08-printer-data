max_power = 1.0
kick_start_time = 0.5
heater = extruder
heater_temp = 50
tachometer_pin = extra_mcu:PA1
tachometer_ppr = 1
tachometer_poll_interval = 0.0013

[gcode_arcs]
resolution = 1.0

[led main_led]
white_pin = PA3
cycle_time = 0.010
hardware_pwm = False
initial_white = 1.0

[idle_timeout]
gcode = _IDLE_TIMEOUT
timeout = 600

[temperature_sensor mcu_temp]
