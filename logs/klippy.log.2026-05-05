sensor_type = my_thermistor
sensor_pin = PC5
max_power = 1.0
min_temp = 5
max_temp = 105
control = pid
pid_kp = 71.880
pid_ki = 1.822
pid_kd = 708.915

[verify_heater heater_bed]
max_error = 120
check_gain_time = 40
hysteresis = 5
heating_gain = 2

[quad_gantry_level]
gantry_corners = 
	-60,-10
	410,420
points = 
	
	
	
	
	
	
	
	
	
	
	36,10
	36,320
	346,320
	346,10
speed = 150
horizontal_move_z = 8
retry_tolerance = 0.1
retries = 5
max_adjust = 15

[multi_pin print_cooling_fan_pins]
