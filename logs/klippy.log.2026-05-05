event_delay = 3.0
pause_delay = 0.5
switch_pin = PE9

[thermistor my_thermistor]
temperature1 = 25
resistance1 = 100000
temperature2 = 50
resistance2 = 18085.4
temperature3 = 100
resistance3 = 5362.6

[bed_mesh]
speed = 400
horizontal_move_z = 2.0
mesh_min = 30, 30
mesh_max = 300, 300
probe_count = 9,9
algorithm = bicubic
split_delta_z = 0.012
mesh_pps = 3,3
adaptive_margin = 5
fade_start = 1
fade_end = 10
fade_target = 0

[homing_override]
gcode = 
	
	G91
	G0 Z5 F1000
	{% if not rawparams or 'Y' in rawparams %}
	{action_respond_info('Homing Y')}
	G28 Y
	G90
	G0 Y177.5 F6000
	M400
	{% endif %}
	{% if not rawparams or 'X' in rawparams %}
	{action_respond_info('Homing X')}
	G28 X
	G90
	G0 X177.5 F6000
	M400
	{% endif %}
	{% if not rawparams or 'Z' in rawparams %}
	{action_respond_info('Homing Z')}
	G90
	G0 X177.5 Y177.5 F6000
	G28 Z
	
	G0 Z10 F1000
	G0 Z2 F1000
	M400
	PROBE_EDDY_NG_PROBE_STATIC HOME_Z=1
	G0 Z5 F1000
	M400
	{% endif %}
	G90
axes = xyz
set_position_z = 0

[heater_bed]
