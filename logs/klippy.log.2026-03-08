interpolate = True
run_current = 0.8
uart_address = 3
sense_resistor = 0.150

[verify_heater extruder]
max_error = 120
check_gain_time = 30
hysteresis = 5
heating_gain = 2

[filament_switch_sensor filament_sensor]
pause_on_runout = True
event_delay = 3.0
pause_delay = 0.5
switch_pin = PE9

[thermistor my_thermistor]
temperature1 = 25
resistance1 = 100000
temperature2 = 50
resistance2 = 18085.4
temperature3 = 100
resistance3 = 5362.6

[bed_mesh]
speed = 400
horizontal_move_z = 2.0
mesh_min = 30, 30
mesh_max = 300, 300
probe_count = 9,9
algorithm = bicubic
split_delta_z = 0.012
mesh_pps = 3,3
adaptive_margin = 5
