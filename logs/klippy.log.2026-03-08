gantry_corners = 
	-60,-10
	410,420
points = 
	
	
	
	
	
	
	
	
	
	
	36,10
	36,320
	346,320
	346,10
speed = 150
horizontal_move_z = 8
retry_tolerance = 0.1
retries = 5
max_adjust = 30

[multi_pin print_cooling_fan_pins]
