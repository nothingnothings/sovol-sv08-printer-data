dir_pin = PD5
enable_pin = !PB5
rotation_distance = 40
gear_ratio = 80:12
microsteps = 16

[tmc2209 stepper_z2]
uart_pin = PD6
interpolate = true
run_current = 0.55
sense_resistor = 0.150
stealthchop_threshold = 999999
uart_address = 3

[stepper_z3]
step_pin = PD11
dir_pin = !PD9
enable_pin = !PD12
rotation_distance = 40
gear_ratio = 80:12
microsteps = 16

[tmc2209 stepper_z3]
uart_pin = PD10
interpolate = true
run_current = 0.55
sense_resistor = 0.150
uart_address = 3
stealthchop_threshold = 999999

[thermistor my_thermistor_e]
temperature1 = 25
resistance1 = 110000
temperature2 = 100
resistance2 = 7008
temperature3 = 220
resistance3 = 435

[extruder]
step_pin = extra_mcu:PA8
dir_pin = extra_mcu:PB8
enable_pin = !extra_mcu: PB11
rotation_distance = 6.5
microsteps = 16
full_steps_per_rotation = 200
nozzle_diameter = 0.400
filament_diameter = 1.75
max_extrude_only_distance = 150
heater_pin = extra_mcu:PB9
sensor_type = my_thermistor_e
