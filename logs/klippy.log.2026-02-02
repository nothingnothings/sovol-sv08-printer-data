tachometer_poll_interval = 0.0013

[gcode_arcs]
resolution = 1.0

[led main_led]
white_pin = PA3
cycle_time = 0.010
hardware_pwm = False
initial_white = 1.0

[idle_timeout]
gcode = _IDLE_TIMEOUT
timeout = 600

[temperature_sensor mcu_temp]
