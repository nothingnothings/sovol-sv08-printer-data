i2c_bus = i2c0f
x_offset = -16
y_offset = 11.5
calibrated_drive_currents = 15
calibration_version = 5
reg_drive_current = 15
tap_drive_current = 15
calibration_15 = 

[temperature_sensor btt_eddy_mcu]
