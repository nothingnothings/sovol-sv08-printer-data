enable = {not (printer.print_stats.state == "paused" or printer.idle_timeout.state == "Printing")}
name = Move
index = 8

[menu __main __control __disable]
type = command
name = Steppers off
gcode = 
	M84
	M18
	{menu.exit()}

[menu __main __control __home]
type = command
