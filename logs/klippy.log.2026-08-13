	-60,-10
	410,420
points = 
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	65,23
	65,310
	354,310
	354,23
speed = 150
horizontal_move_z = 8
retry_tolerance = 0.1
retries = 5
max_adjust = 10

[multi_pin print_cooling_fan_pins]
