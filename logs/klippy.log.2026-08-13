position_max = 347
position_min = -5
homing_speed = 5.0
homing_retract_dist = 5.0
homing_retract_speed = 15.0
second_homing_speed = 5.0

[tmc2209 stepper_z]
uart_pin = PE6
interpolate = true
run_current = 0.58
hold_current = 0.30
sense_resistor = 0.150
stealthchop_threshold = 999999
uart_address = 3

[stepper_z1]
step_pin = PD3
dir_pin = !PD1
enable_pin = !PD4
rotation_distance = 40
gear_ratio = 80:12
microsteps = 16

[tmc2209 stepper_z1]
