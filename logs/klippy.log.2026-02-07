	M117 Resume printing
	{% if "pause_resume" in printer %}
	RESUME
	{% else %}
	M24
	{% endif %}
	{menu.exit()}

[menu __main __pause]
type = command
enable = {('virtual_sdcard' in printer) and printer.print_stats.state == "printing"}
name = Pause printing
index = 3
