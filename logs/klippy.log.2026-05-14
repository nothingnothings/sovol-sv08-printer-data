sensor_pin = extra_mcu:PA5
min_temp = 5
max_temp = 305
max_power = 1.0
min_extrude_temp = 5
pressure_advance = 0.025
pressure_advance_smooth_time = 0.035
control = pid
pid_kp = 30.317
pid_ki = 8.085
pid_kd = 28.422

[tmc2209 extruder]
