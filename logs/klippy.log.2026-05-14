probe_points = 
	175, 175, 30
accel_per_hz = 50
min_freq = 1
max_freq = 100
max_smoothing = 0.2
hz_per_sec = 0.5

[input_shaper]
damping_ratio_x = 0.001
damping_ratio_y = 0.001
shaper_type_x = mzv
shaper_freq_x = 60.4
shaper_type_y = mzv
shaper_freq_y = 41.4

[save_variables]
filename = ~/printer_data/config/saved_variables.cfg

