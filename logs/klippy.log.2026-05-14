[gcode_arcs]
resolution = 1.0

[led main_led]
white_pin = PA3
cycle_time = 0.010
hardware_pwm = False
initial_white = 1.0

[idle_timeout]
gcode = _IDLE_TIMEOUT
timeout = 600

[temperature_sensor mcu_temp]
sensor_type = temperature_mcu
min_temp = 0
max_temp = 100

[temperature_sensor Host_temp]
sensor_type = temperature_host
min_temp = 0
max_temp = 110

[temperature_sensor Toolhead_Temp]
