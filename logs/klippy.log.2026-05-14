sensor_type = my_thermistor
sensor_pin = PC5
max_power = 1.0
min_temp = 5
max_temp = 105
control = pid
pid_kp = 71.880
pid_ki = 1.822
pid_kd = 708.915

[verify_heater heater_bed]
max_error = 120
check_gain_time = 40
hysteresis = 5
heating_gain = 2

