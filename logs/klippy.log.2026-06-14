	G4 P200
	M400
	G1 Z1.0 F600
	G1 Y359 X354 F10000
	G1 Y356 X308 F10000
	M400
	M117 CLEANING BLOW
	G1 Z12.0 F600
	M400
	G1 Y280 X350 F4000
	G1 Y240 X240
