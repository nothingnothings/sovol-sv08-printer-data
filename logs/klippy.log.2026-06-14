	LCD_ORANGE
	_SET_TEMPERATURE EXTRUDER_TEMP={extruder_temp} BED_TEMP={bed_temp} WAIT=True
	_SET_TEMPERATURE BED_TEMP=0
	LCD_WHITE
	M117 CLEANING BLOB
	G1 Z{printer["gcode_macro _global_var"].clean_blob_extrusion_height} F400
