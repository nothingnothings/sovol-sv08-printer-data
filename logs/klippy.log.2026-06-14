position_max = 364
homing_speed = 30
homing_retract_dist = 0
homing_positive_dir = true

[tmc2209 stepper_y]
uart_pin = PB7
interpolate = True
run_current = 1.1
sense_resistor = 0.150
stealthchop_threshold = 0
uart_address = 3
driver_sgthrs = 70
diag_pin = PE13

[stepper_z]
