	G90
	G0 X177.5 Y177.5 F6000
	G28 Z
	
	G0 Z10 F1000
	G0 Z2 F1000
	M400
	PROBE_EDDY_NG_PROBE_STATIC HOME_Z=1
	G0 Z5 F1000
	M400
	{% endif %}
	G90
