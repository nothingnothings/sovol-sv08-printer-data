	G90
	G1 X5 Y5 Z0.4 F3000
	
	
	M117 Purging Blob...
	G1 E20 F150
	G1 Z3.0 F3000
	G1 X20 F3000
	G1 Z0.4 F3000
	
	
	G1 X150 E30 F1200
	G1 Y5.8 F5000
	G1 X25 E30 F1200
	
	
	M117 "Retracting"
	G1 E-1.0 F3000
	G1 Z5.0 F3000

[gcode_macro _IDLE_TIMEOUT]
gcode = 
	{% if printer.print_stats.state == "paused" %}
	RESPOND TYPE=echo MSG="No operations in 10min!"
	{% else %}
	M84
	TURN_OFF_HEATERS
	{% endif %}

[delayed_gcode exhaust_fan_off]
