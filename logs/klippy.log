[printer]
kinematics = corexy
max_velocity = 700
max_accel = 40000
minimum_cruise_ratio = 0.5
max_z_velocity = 20
max_z_accel = 500
square_corner_velocity = 5.0

[stepper_x]
step_pin = PE2
dir_pin = !PE0
enable_pin = !PE3
rotation_distance = 40
