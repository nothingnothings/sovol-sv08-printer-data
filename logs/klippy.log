[gcode_macro START_PRINT]
gcode = 
	
	
	{% set target_bed = params.BED|default(params.BED_TEMP)|int %}
	{% set target_extruder = params.EXTRUDER|default(params.EXTRUDER_TEMP)|int %}
	{% set x_wait = printer.toolhead.axis_maximum.x|float / 2 %}
	{% set y_wait = printer.toolhead.axis_maximum.y|float / 2 %}
	
	
	M140 S{target_bed}
	M104 S150
	
	
	G28
	M190 S{target_bed}
	
	
	
	
	
	QUAD_GANTRY_LEVEL
	G28 Z
	
	
	LINE_PURGE
	
	G28 Z
	
	
	PROBE_EDDY_NG_TAP
	
	
	BED_MESH_CALIBRATE ADAPTIVE=1
	
	
	G1 X{x_wait} Y{y_wait} Z15 F9000
	M109 S{target_extruder}

[gcode_macro END_PRINT]
gcode = 
	
	TURN_OFF_HEATERS
	M107
	
	
	G91
	G1 X-2 Y-2 E-3 F300
	G1 Z20 F3000
	
	
	G90
	G1 X175 Y350 F3000
	
	
	CLEAR_PAUSE
	M117 Print Finished

[gcode_macro LINE_PURGE]
gcode = 
	M83
	G90
	G1 X5 Y5 Z0.4 F3000
	
	
	M117 Purging Blob...
	G1 E20 F150
	G1 Z3.0 F3000
	G1 X20 F3000
	G1 Z0.4 F3000
	
	
	G1 X150 E30 F1200
	G1 Y5.8 F5000
	G1 X25 E30 F1200
	
	
	M117 "Retracting"
	G1 E-1.0 F3000
	G1 Z5.0 F3000

[gcode_macro _IDLE_TIMEOUT]
