	G1 X20 F3000
	G1 Z0.4 F3000
	
	
	G1 X150 E30 F1200
	G1 Y5.8 F5000
	G1 X25 E30 F1200
	
	
	G1 E-1.0 F3000
	G1 Z5.0 F3000

