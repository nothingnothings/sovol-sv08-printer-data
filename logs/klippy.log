chain_count = 3
color_order = RGB
initial_red = 0.5
initial_green = 0.4
initial_blue = 0.7

[gcode_macro BEEP]
gcode = 
	SET_PIN PIN=beeper VALUE=1
	G4 P10
	SET_PIN PIN=beeper VALUE=0

