restart_method = command

[printer]
kinematics = corexy
max_velocity = 700
max_accel = 40000
minimum_cruise_ratio = 0.5
max_z_velocity = 20
max_z_accel = 500
square_corner_velocity = 5.0

[stepper_x]
step_pin = PE2
dir_pin = !PE0
enable_pin = !PE3
rotation_distance = 40
microsteps = 16
full_steps_per_rotation = 200
endstop_pin = tmc2209_stepper_x: virtual_endstop
position_min = 0
position_endstop = 355
position_max = 355
homing_speed = 30
homing_retract_dist = 0
homing_positive_dir = True

[tmc2209 stepper_x]
uart_pin = PE1
interpolate = True
run_current = 1.1
sense_resistor = 0.150
stealthchop_threshold = 0
uart_address = 3
driver_sgthrs = 70
diag_pin = PE15

[stepper_y]
