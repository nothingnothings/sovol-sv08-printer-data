split_delta_z = 0.012
mesh_pps = 3,3
adaptive_margin = 5
fade_start = 1
fade_end = 10
fade_target = 0

[homing_override]
gcode = 
	
	G91
	G0 Z5 F1000
	{% if not rawparams or 'Y' in rawparams %}
	{action_respond_info('Homing Y')}
	G28 Y
	G90
	G0 Y177.5 F6000
	M400
	{% endif %}
	{% if not rawparams or 'X' in rawparams %}
	{action_respond_info('Homing X')}
	G28 X
	G90
	G0 X177.5 F6000
	M400
	{% endif %}
	{% if not rawparams or 'Z' in rawparams %}
