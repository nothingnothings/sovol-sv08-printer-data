max_temp = 100

[temperature_sensor Host_temp]
sensor_type = temperature_host
min_temp = 0
max_temp = 110

[temperature_sensor Toolhead_Temp]
sensor_type = temperature_mcu
sensor_mcu = extra_mcu

[exclude_object]

[adxl345]
cs_pin = extra_mcu:PB12

[resonance_tester]
accel_chip = adxl345
probe_points = 
	175, 175, 30
accel_per_hz = 50
min_freq = 1
max_freq = 100
max_smoothing = 0.2
hz_per_sec = 0.5

[input_shaper]
damping_ratio_x = 0.001
damping_ratio_y = 0.001
shaper_type_x = mzv
shaper_freq_x = 35
shaper_type_y = mzv
shaper_freq_y = 35

[save_variables]
filename = ~/printer_data/config/saved_variables.cfg

