resistance1 = 100000
temperature2 = 50
resistance2 = 18085.4
temperature3 = 100
resistance3 = 5362.6

[bed_mesh]
speed = 400
horizontal_move_z = 2.0
mesh_min = 30, 30
mesh_max = 300, 300
probe_count = 9,9
algorithm = bicubic
split_delta_z = 0.012
mesh_pps = 3,3
adaptive_margin = 5
fade_start = 1
fade_end = 10
fade_target = 0

[heater_bed]
